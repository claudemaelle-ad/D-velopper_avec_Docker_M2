# Nom du projet : préfixe des conteneurs, réseaux et volumes
COMPOSE_PROJECT_NAME=citation-du-jour

# Port d'accès à l'application depuis la machine (seul port exposé) 
NGINX_PORT=8081

# Ports internes des applications (dans le réseau Docker)
FRONT_PORT=3000
BACK_PORT=5000

# Ressources allouées à chaque conteneur (pour limiter l'usage CPU et mémoire)
# CPUS : part de processeur (0.5 = un demi-cœur)
# MEMORY : mémoire maximale (M = mégaoctets)
# Valeurs choisies d'après les benchmarks (environ 2x le pic mesuré)
BACK_CPUS=0.5
BACK_MEMORY=128M
FRONT_CPUS=0.25
FRONT_MEMORY=64M
NGINX_CPUS=0.25
NGINX_MEMORY=64M

# Ressources des conteneurs CI/CD (lancés à la demande)
LINT_CPUS=0.5
LINT_MEMORY=128M
TESTS_CPUS=0.5
TESTS_MEMORY=128M
